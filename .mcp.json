{
    "mcpServers": {
      "postgres-quiz": {
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-postgres",
          "postgresql://quiz_user:quiz_password@postgres:5432/quiz_db"
        ]
      },
      "chrome-devtools": {
        "command": "npx",
        "args": ["-y", "chrome-devtools-mcp@latest"]
      },
      "playwright": {
        "command": "npx",
        "args": ["-y", "@playwright/mcp@latest", "--browser", "chrome"]
      },
      "linear": {
        "type": "http",
        "url": "https://mcp.linear.app/mcp"
      }
    }
  }
  